@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="fx-card fx-status">
    <div class="fx-status-icon danger"><i class="bi bi-exclamation-octagon"></i></div>
    <h1 class="fx-page-title mb-2">Ocurrió un error</h1>
    <p class="text-muted">Se produjo un error al procesar su solicitud. Intente nuevamente en unos instantes.</p>

    @if (Model.ShowRequestId)
    {
        <p class="mb-4">
            <span class="text-muted small">ID de la solicitud:</span>
            <code class="fx-id">@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
        <i class="bi bi-house-door"></i> Volver al inicio
    </a>

    <hr class="my-4" />

    <div class="text-start small text-muted">
        <p class="fw-semibold text-body mb-1"><i class="bi bi-code-slash"></i> Modo de desarrollo</p>
        <p class="mb-1">
            Cambiar al entorno <strong>Development</strong> muestra información más detallada sobre el error.
        </p>
        <p class="mb-0">
            <strong>El entorno Development no debe habilitarse en aplicaciones publicadas</strong>, ya que puede exponer
            información sensible de las excepciones a los usuarios. Para depurar localmente, establezca la variable de entorno
            <strong>ASPNETCORE_ENVIRONMENT</strong> en <strong>Development</strong> y reinicie la aplicación.
        </p>
    </div>
</div>
