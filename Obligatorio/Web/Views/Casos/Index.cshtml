@using Dominio;
@{
    ViewData["Title"] = "Casos";
}

<h4>Listado de casos</h4>

<br />

@if (ViewBag.Listado != null)
{
    if (ViewBag.Listado.Count == 0)
    {
        <div class="alert alert-danger">No hay casos en el Sistema</div>
    }
    else
    {
        <table class="table table-striped">
            <tr>
                <th>Id</th>
                <th>Caso</th>
                <th>Descripcion</th>
                <th>Investigador</th>
                <th>Sospechoso</th>
                <th>Cerrado</th>
                <th>Acciones</th>
            </tr>
            @foreach (Caso c in ViewBag.Listado)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Nombre</td>
                    <td>@c.Descripcion</td>
                    <td>@c.Investigador.Nombre</td>
                    <td>@c.Sospechoso.Nombre</td>
                    @if (c.Cerrado) {<td>Si</td>} else {<td>No</td>}
                    <td><a href="/casos/detalles/@c.Id">Ver</a></td>
                </tr>
            }
        </table>
    }
}