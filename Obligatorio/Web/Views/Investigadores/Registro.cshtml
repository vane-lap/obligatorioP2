@using Dominio;
@{
    ViewData["Title"] = "Registro";
}

<h4>Registro</h4>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (ViewBag.Exito != null)
{
    <div class="alert alert-success">@ViewBag.Exito</div>
}

<form method="post" action="/Registro">
    <label>Nombre:</label>
    <input type="text" placeholder="Ingrese el nombre" name="nombre" value="@ViewBag.Nombre"/>
    <label>Email:</label>
    <input type="text" placeholder="Ingrese el email" name="email" value="@ViewBag.Email"/>
    <label>Contraseña:</label>
    <input type="text" placeholder="Ingrese la contraseña" name="contrasena" value="@ViewBag.Contrasena"/>
    <input type="submit" value="Registrar" class="btn btn-success"/>
</form>