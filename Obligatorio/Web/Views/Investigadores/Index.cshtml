@using Dominio;
@{
    ViewData["Title"] = "Login";
}

<h4>Login</h4>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (ViewBag.Exito != null)
{
    <div class="alert alert-success">@ViewBag.Exito</div>
}

<form method="post" action="/Investigadores">
    <label>Email:</label>
    <input type="email" placeholder="Ingrese email" name="email" value="@ViewBag.Email"/>
    <label>Contraseña:</label>
    <input type="text" placeholder="Ingrese contraseña" name="pass" value="@ViewBag.Pass"/>
    <input type="submit" value="Ingresar" class="btn btn-success"/>
</form>