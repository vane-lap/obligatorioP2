@using Dominio;
@{
    ViewData["Title"] = "Perfil";
}

<h4>Mi Perfil</h4>

@if (ViewBag.Investigador != null)
{
    Investigador unInvestigador = ViewBag.Investigador;
    <label>Tu email es:</label>
    <p>@unInvestigador.Email</p>
    <label>Tu nombre es:</label>
    <p>@unInvestigador.Nombre</p>
    <label>Tu rol es:</label>
    <p>@unInvestigador.Rol.ToString()</p>
}